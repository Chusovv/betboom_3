# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=ваш_токен_здесь

# Telegram user ID (узнать у @userinfobot)
ADMIN_ID=ваш_id_здесь

# Стримеры для отслеживания (через запятую, без @)
STREAMERS=recrent,nix,justcooman,relaxcis,dayneez,vovapain,blindzone

# Twitch IRC
TWITCH_NICK=pressferr
TWITCH_OAUTH_TOKEN=oauth:ваш_токен_здесь

# TTL кэша ссылок (минуты) — чтобы не слать дубли
LINK_CACHE_TTL_MIN=60

# Прокси для Telegram (опционально, если api.telegram.org недоступен)
# TELEGRAM_PROXY=socks5://127.0.0.1:1080